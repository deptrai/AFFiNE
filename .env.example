# AFFiNE Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=production
LOG_LEVEL=info
AFFINE_CONFIG_PATH=/app/config

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgres://affine:affine@postgres:5432/affine
POSTGRES_DB=affine
POSTGRES_USER=affine
POSTGRES_PASSWORD=affine

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_SERVER_HOST=redis
REDIS_SERVER_PORT=6379
REDIS_PASSWORD=affine

# =============================================================================
# AI PROVIDER API KEYS
# =============================================================================
# OpenAI API Key (for GPT models)
COPILOT_OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (for Claude models)
COPILOT_ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google Gemini API Key
COPILOT_GEMINI_API_KEY=your-gemini-api-key-here

# Perplexity API Key
COPILOT_PERPLEXITY_API_KEY=pplx-your-perplexity-api-key-here

# =============================================================================
# DOCKER REGISTRY SETTINGS
# =============================================================================
DOCKER_REGISTRY=registry.joyone.vn
IMAGE_NAME=affine
IMAGE_TAG=latest

# =============================================================================
# DEPLOYMENT SETTINGS
# =============================================================================
STACK_NAME=affine-staging
DOMAIN=affine-staging.joyone.vn

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# JWT Secret (generate a random string)
JWT_SECRET=your-jwt-secret-here

# Session Secret (generate a random string)
SESSION_SECRET=your-session-secret-here

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Enable metrics collection
ENABLE_METRICS=true

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable AI features
ENABLE_COPILOT=true

# Enable collaboration features
ENABLE_COLLABORATION=true

# Enable cloud sync
ENABLE_CLOUD_SYNC=true

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE=100

# Request timeout (in seconds)
REQUEST_TIMEOUT=30

# Connection pool size
DB_POOL_SIZE=10

# =============================================================================
# DEVELOPMENT SETTINGS (for local development only)
# =============================================================================
# Enable hot reload
HOT_RELOAD=false

# Enable debug mode
DEBUG=false

# Enable verbose logging
VERBOSE=false
